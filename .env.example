# Copy to .env next to docker-compose.yml and fill in.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Keep it in single quotes: Docker Compose would otherwise treat any $ in it as a variable.
SECRET_KEY='change-me'
DEBUG=False

# Admin domain reached via Cloudflare Tunnel.
ALLOWED_HOSTS=admin.engineericly.com
# Needed for the admin login over HTTPS. Include the scheme.
CSRF_TRUSTED_ORIGINS=https://admin.engineericly.com

# Public static site URL on Cloudflare Pages.
PUBLIC_SITE_URL=https://links.engineericly.com
# Cloudflare Pages project name.
CF_PAGES_PROJECT=engineericly-links
# Cloudflare API token with Cloudflare Pages edit permissions.
CLOUDFLARE_API_TOKEN=
# Cloudflare account ID for Pages deployments.
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare Tunnel token for the cloudflared container.
TUNNEL_TOKEN=

# Optional
# PORT=9192               # host port the app listens on
# BIND_ADDRESS=127.0.0.1  # 0.0.0.0 if the nginx routing to it is not on this VM
# DATA_DIR=./data         # where the database and uploads are kept on the host
# GUNICORN_WORKERS=3
# GUNICORN_LOG_LEVEL=info
# SECURE_COOKIES=True   # defaults to True when DEBUG=False; set False if you test over plain http
