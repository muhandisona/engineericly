# Copy to .env next to docker-compose.yml and fill in.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Keep it in single quotes: Docker Compose would otherwise treat any $ in it as a variable.
SECRET_KEY='change-me'
DEBUG=False

# Your public domain(s), comma separated.
ALLOWED_HOSTS=feed.example.com
# Needed for the admin login over HTTPS. Include the scheme.
CSRF_TRUSTED_ORIGINS=https://feed.example.com

# Optional
# PORT=9192               # host port the app listens on
# BIND_ADDRESS=127.0.0.1  # 0.0.0.0 if the nginx routing to it is not on this VM
# DATA_DIR=./data         # where the database and uploads are kept on the host
# GUNICORN_WORKERS=3
# GUNICORN_LOG_LEVEL=info
# SECURE_COOKIES=True   # defaults to True when DEBUG=False; set False if you test over plain http
